# Sigma AI Configuration

# Primary model (any pydantic-ai model string)
# Examples:
#   openai:gpt-4o
#   openai:gpt-4o-mini
#   anthropic:claude-3-5-sonnet-20241022
#   anthropic:claude-3-haiku-20240307
#   google-gla:gemini-1.5-pro
#   google-gla:gemini-1.5-flash
#   groq:llama-3.1-70b-versatile
#   mistral:mistral-large-latest
#   ollama:llama3          # local, no key required
model: "anthropic:claude-haiku-5-5"

# API keys for model providers
# Leave blank ("") if you don't use that provider
api_keys:
  openai: ""
  anthropic: ""
  google: ""        # sets GEMINI_API_KEY
  groq: ""
  mistral: ""
  fireworks: ""
  together: ""
  cohere: ""

# Additional models to display in the web UI dropdown
# Users can switch between them during a chat session
extra_models:
  - "anthropic:claude-haiku-4-5"
  - "anthropic:claude-sonnet-5-5"
  - "anthropic:claude-opus-5-5"
  - "openai:gpt-6-luna"
  - "openai:gpt-6.1-terra"
  - "openai:gpt-6.1-sol"

# Sigma MCP server
# simone gets all Sigma functionality (validation, SigmaHQ rule search,
# logsource knowledge, file names) from sigma-mcp-server, which it starts as a
# subprocess. The server downloads and caches the SigmaHQ rules itself.
sigma_mcp:
  # Command that starts the server. Leave empty to use the sigma-mcp-server
  # installed together with simone.
  command: ""
  args: []
  # Extra environment variables for the server, for example:
  #   SIGMA_MCP_DATA_DIR: "~/.simone/sigma-mcp"   # where rules are cached
  #   SIGMA_MCP_INDEX_MAX_AGE_DAYS: "7"           # refresh interval, 0 = never
  # Proxy and CA settings (HTTPS_PROXY, SSL_CERT_FILE, ...) and SIGMA_MCP_*
  # variables from simone's environment are passed on automatically.
  env: {}

# Generated rules output directory
output:
  # Directory where generated Sigma rules will be saved
  # Use ~ for the home directory
  # Files are named according to SigmaHQ conventions (lowercase, underscores)
  # If a file exists, an index is appended (e.g., rule_name-2.yml) to avoid overwriting
  directory: "~/.simone/generated-rules"

# Web server settings
server:
  host: "127.0.0.1"
  port: 7932
